rules_version = '2';

// Paste this whole file into: Firebase Console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    // Presence: any signed-in user can see who's live,
    // but you can only edit your own entry.
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Calls: only the two people in a call can see or change it.
    match /calls/{callId} {
      allow create: if request.auth != null
                    && request.resource.data.from == request.auth.uid;
      allow read, update: if request.auth != null
                    && (resource.data.from == request.auth.uid
                        || resource.data.to == request.auth.uid);
      allow delete: if false;

      // Connection details (ICE candidates) exchanged during the call
      match /{part}/{candidateId} {
        allow read, create: if request.auth != null
          && (get(/databases/$(database)/documents/calls/$(callId)).data.from == request.auth.uid
              || get(/databases/$(database)/documents/calls/$(callId)).data.to == request.auth.uid);
      }
    }
  }
}
